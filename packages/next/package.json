{
  "name": "@skyloupe/next",
  "version": "0.2.0",
  "type": "module",
  "sideEffects": false,
  "description": "Next.js app-router helper. The loader runs in development only.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
